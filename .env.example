PLATFORM=kook
PLATFORM_TOKEN=replace-with-a-new-kook-token
API_KEY=replace-with-provider-api-key
BASE_URL=https://provider.example.com/v1
LLM_PROVIDER=openai
LLM_MODEL_ID=provider-model-name
LANGUAGE=CN

# Pi Headless Runtime 可选覆盖；未设置时复用上面的 API_KEY/BASE_URL/LLM_PROVIDER/LLM_MODEL_ID。
# PI_PROVIDER=openai
# PI_MODEL=provider-model-name
# PI_API_KEY=replace-with-provider-api-key
# PI_BASE_URL=https://provider.example.com/v1
# PI_API=openai-completions
# PI_THINKING_LEVEL=medium

# 可选：不设置时不向第三方接口发送 thinking 开关。
# AGENT_THINK_ENABLED=true
THINK_PARAMETER=enable_thinking

# 可选限制（字节）。
MAX_ATTACHMENT_BYTES=10485760
MAX_ARTIFACT_BYTES=10485760

# MySQL 连接
SQL_HOST=localhost
SQL_PORT=3306
SQL_USER=root
SQL_PASSWD=your-password
SQL_DATABASE=your-database
