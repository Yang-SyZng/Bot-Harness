PLATFORM=kook
PLATFORM_TOKEN=replace-with-a-new-kook-token
API_KEY=replace-with-provider-api-key
BASE_URL=https://provider.example.com/v1
LLM_PROVIDER=openai
LLM_MODEL_ID=provider-model-name
LANGUAGE=CN

# Optional Pi headless runtime overrides. Defaults to API_KEY, BASE_URL, LLM_PROVIDER, and LLM_MODEL_ID above.
# PI_PROVIDER=openai
# PI_MODEL=provider-model-name
# PI_API_KEY=replace-with-provider-api-key
# PI_BASE_URL=https://provider.example.com/v1
# PI_API=openai-completions
# PI_THINKING_LEVEL=medium

# Optional trusted operator instructions (maximum 4000 characters).
# Never put API keys, tokens, platform user IDs, or other secrets here.
# SYSTEM_PROMPT_EXTRA=Prefer concise answers unless the user asks for detail.

# Optional. Leave unset to avoid sending a thinking toggle to third-party APIs.
# AGENT_THINK_ENABLED=true
THINK_PARAMETER=enable_thinking

# Optional limits in bytes.
MAX_ATTACHMENT_BYTES=10485760
MAX_ARTIFACT_BYTES=10485760
TOOL_TIMEOUT_MS=15000
MAX_TOOL_CALLS_PER_RUN=12
MAX_TOOL_RESULT_CHARACTERS=20000
MAX_FILE_READ_CHARACTERS=100000
WORKSPACE_ROOT=workspaces
WORKSPACE_TTL_MS=86400000

# MySQL connection
SQL_HOST=localhost
SQL_PORT=3306
SQL_USER=root
SQL_PASSWD=your-password
SQL_DATABASE=your-database
