PLATFORM=bot-platform
PLATFORM_TOKEN=replace-with-a-new-kook-token
API_KEY=replace-with-provider-api-key
BASE_URL=https://provider.example.com/v1
LLM_MODEL_ID=provider-model-name
LANGUAGE=CN

# 可选：不设置时不向第三方接口发送 thinking 开关。
# AGENT_THINK_ENABLED=true
THINK_PARAMETER=enable_thinking

# 可选限制（字节）。
MAX_ATTACHMENT_BYTES=10485760
MAX_ARTIFACT_BYTES=10485760

# MySQL 连接
SQL_HOST=localhost
SQL_PORT=3306
SQL_USER=root
SQL_PASSWD=your-password
SQL_DATABASE=your-database
